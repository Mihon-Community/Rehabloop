# =============================================================================
# RehabLoop environment â€” copy to .env and fill in values locally.
#   cp .env.example .env
# Secret values are intentionally BLANK. Never commit .env.
# VITE_* values are PUBLIC build-time config for the browser; everything else
# is server-side. Never put a service-role key or NVIDIA key in VITE_*.
# =============================================================================

# --- App / shared -----------------------------------------------------------
# Deployment profile: local | staging | production.
APP_ENV=local
# dev is local-only synthetic auth. Supabase mode verifies asymmetric tokens
# through JWKS and legacy HS256 tokens through Supabase Auth.
AUTH_MODE=dev
# Logging verbosity: DEBUG | INFO | WARNING | ERROR. Backend + vision.
LOG_LEVEL=INFO
# Comma-separated allowed browser origins for CORS. Backend. Not a secret.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (PUBLIC build-time config; Steve) ------------------------------
# Supabase project URL, public. Used by frontend (Vite build).
VITE_SUPABASE_URL=
# Supabase anon key â€” public but RLS-scoped. NEVER use as an auth bypass.
VITE_SUPABASE_ANON_KEY=
# Base URL of the FastAPI backend. Frontend. Public.
VITE_API_BASE_URL=http://localhost:8000
# Browser frame sampling target, frames per second (5-10). Frontend. Public.
VITE_FRAME_SAMPLE_RATE=8

# --- Backend (SERVER-SIDE; Lennox) ------------------------------------------
# Supabase project URL, server-side. Backend. Not a secret.
SUPABASE_URL=
# Supabase JWKS URL used by the backend to verify Supabase Auth JWTs. Backend. Not a secret.
SUPABASE_JWKS_URL=
# Public Supabase anon/publishable key; used only to verify legacy HS256 tokens via Auth.
SUPABASE_ANON_KEY=
# SECRET. Supabase secret key (service role); bypasses RLS. Backend only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=
# SECRET. NVIDIA hosted API key. Backend only. Never commit.
NVIDIA_API_KEY=
# NVIDIA OpenAI-compatible base URL. Backend. Not a secret.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Exact model id tested in the NVIDIA API Catalog. Backend. Not a secret.
NVIDIA_MODEL_ID=
# When false, no raw camera frames/video are persisted (default and required).
STORE_RAW_VIDEO=false
# Configured frame-rate limit for the sampler/stream, engineering value.
MAX_FRAME_RATE=8
# Internal vision service base URL used by the backend movement pipeline.
VISION_SERVICE_URL=http://vision_service:8001
# TTL in seconds for short-lived per-session WebSocket streaming tokens.
SESSION_TOKEN_TTL_SECONDS=300

# --- Vision service (Lennox) ------------------------------------------------
# fixture (labelled simulated) | movenet (CPU MoveNet) | sapiens (legacy, licence-gated).
VISION_MODE=fixture
# MoveNet runs on CPU. Sapiens requires a separate legal review.
VISION_DEVICE=cpu
# Local model directory, mounted read-only at /models. Keep weights outside Git.
MOVENET_MODEL_ROOT=
MOVENET_MODEL_PATH=/models/movenet_singlepose_lightning.tflite
MOVENET_MODEL_NAME=movenet-singlepose-lightning
MOVENET_TARGET_SIDE=left
MOVENET_CPU_THREADS=2
